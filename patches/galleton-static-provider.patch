+++ b/internal/core/static_test.go
@@ -0,0 +1,34 @@
+package core
+
+import (
+ "net/http"
+ "net/http/httptest"
+ "strings"
+ "sync/atomic"
+ "testing"
+ "time"
+)
+
+func TestStaticStoresCookiesWithoutRenewal(t *testing.T) {
+ var calls atomic.Int32
+ upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls.Add(1); w.WriteHeader(500) }))
+ defer upstream.Close()
+ p := Provider{Name: "test", Kind: "static", Origins: []string{upstream.URL}, AllowHTTPLoopback: true}
+ m, vault, _ := managerFor(t, p)
+ meta, err := m.Import("alice", Import{Provider:"test", CookieOrigin:upstream.URL, CookieHeader:"session=secret"})
+ if err != nil { t.Fatal(err) }
+ if !meta.NextRefresh.IsZero() { t.Fatal("static import must not schedule renewal") }
+ headers, err := m.Headers("alice", upstream.URL)
+ if err != nil || headers.Headers["Cookie"] != "session=secret" { t.Fatalf("headers failed: %v", err) }
+ if _, err := m.Headers("alice", "https://untrusted.example"); err == nil { t.Fatal("origin restriction lost") }
+ if _, err := m.Refresh("alice"); err == nil { t.Fatal("static refresh must fail explicitly") }
+ if _, err := m.Capture("alice", upstream.URL, []string{"session=rotated; Path=/"}); err != nil { t.Fatal(err) }
+ restored, err := NewManager(vault, Config{Providers: []Provider{p}})
+ if err != nil { t.Fatal(err) }
+ headers, err = restored.Headers("alice", upstream.URL)
+ if err != nil || !strings.Contains(headers.Headers["Cookie"],"rotated") { t.Fatal("rotation not persisted") }
+ if calls.Load() != 0 { t.Fatal("storage made a network request") }
+ expired := "old=expired; Path=/; Expires=" + time.Now().Add(-time.Hour).UTC().Format(http.TimeFormat)
+ if _, err := restored.Capture("alice", upstream.URL, []string{expired}); err != nil { t.Fatal(err) }
+ if _, err := compileProviders(Config{Providers: []Provider{{Name:"bad",Kind:"static",Origins:[]string{upstream.URL},RefreshURL:upstream.URL,AllowHTTPLoopback:true}}}); err == nil { t.Fatal("static renewal configuration accepted") }
+}
