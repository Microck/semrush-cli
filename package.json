{
  "name": "semrush-cli",
  "version": "0.12.0",
  "description": "Semrush research from your terminal and MCP clients. TypeScript, Effect, and Galleton.",
  "type": "module",
  "bin": {
    "semrush": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/vendor/GALLETON-LICENSE",
    "README.md",
    "LICENSE",
    "assets",
    "docs/architecture.md",
    "src/vendor/README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-daemon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src tests --deny-warnings",
    "check": "npm run typecheck && npm run lint && node scripts/generate-reference.mjs --check && npm run build && npm test",
    "prepublishOnly": "npm run check",
    "docs:generate": "node scripts/generate-reference.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microck/semrush-cli.git"
  },
  "homepage": "https://semrush.micr.dev",
  "bugs": {
    "url": "https://github.com/Microck/semrush-cli/issues"
  },
  "license": "MIT",
  "author": "Microck <contact@micr.dev>",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "^8.17.1",
    "commander": "^14.0.0",
    "effect": "4.0.4",
    "galleton": "0.1.0",
    "json-bigint": "^1.0.0",
    "patchright": "1.64.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.88.0",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^24.0.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.16.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
